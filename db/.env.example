# Copy to .env.local and fill in a real value. Used only by the Drizzle
# migration tooling (db/schema.ts, drizzle.config.ts) — the macOS app
# stores its own connection string elsewhere (see AGENTS.md).

# Direct (session-mode, non-pooled) Postgres connection string. drizzle-kit
# needs a session connection to run DDL; a transaction pooler won't work.
DIRECT_URL="postgresql://user:password@host:5432/database"
