# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (Drizzle dev tooling)
/node_modules

# env files — never commit real secrets; .env.example is the template
.env*
!.env.example

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
*.tsbuildinfo

# The native app has its own ignore rules in macos/.gitignore
