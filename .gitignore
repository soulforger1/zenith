# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/

# xcodebuild -derivedDataPath build (used for local test builds)
build/

# Swift Package Manager
.build/
.swiftpm/

# Drizzle dev tooling deps (db/)
db/node_modules/

# env files — never commit real secrets; db/.env.example is the template
.env*
!db/.env.example

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
*.tsbuildinfo
